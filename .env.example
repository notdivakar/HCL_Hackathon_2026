# Copy this file to .env and fill in. Never commit .env.

# LLM (leave empty to run in template mode, no LLM calls)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Shown as "From" on every mock email. Nothing is really sent.
# In smtp mode with Gmail this MUST be the same as SMTP_USER
SENDER_EMAIL=care@yourtelco.example
SUPPORT_EMAIL=support@yourtelco.example
COMPANY_NAME=Your Telco

# Pin "today" so offer expiry checks are reproducible in the demo
APP_TODAY=2026-11-17

# Frontend -> backend URL
API_URL=http://localhost:8000

# ---- Real email (optional) ----
# mock = nothing is sent (default). smtp = really send after human approval.
DELIVERY_MODE=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=yourteam@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# Every real email goes here instead of the (fake) customer address
REDIRECT_ALL_TO=your.own.inbox@gmail.com
